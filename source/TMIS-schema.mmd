erDiagram
    %% TMIS Logical Data Model: schema v2, transcribed from the supplied reference diagram.
    %% 31 entities and 213 fields; no entities merged or removed.
    %% The reference draws 60 relationships and omits 18 agency_id tenant links for readability. All 78 foreign-key relationships remain available here.
    %% UUID, bool and int are logical type notation; this update does not migrate a database.
    %% UK marks a unique field. Nullable field names are italic; nullability also appears in field details.
    %% activity.calendar_entry_id and certificate_rule.activity_id are unique foreign keys (at most one child per parent).
    %% Relationship labels identify the foreign-key field in the child table. Optional parents correspond to nullable foreign keys.
    %% Child minimum counts remain zero where the reference does not establish mandatory child existence.
    %% client_id is a unique UUID in attendance, feedback and reentry_plan; no client entity or foreign-key relationship is shown.
    %% Composite uniqueness: session(activity_id, session_date, period); activity_partner(activity_id, partner_agency_id).
    %% session.period: AM | PM. program_flow requires end_time > start_time.
    %% The original draw.io file remains an archived v1 reference. The downloadable Mermaid source describes v2.

    %% agency: category: government_agency | academic_institution | international_entity | private_sector
    agency {
        uuid id PK "not null"
        varchar(255) name UK "not null"
        varchar(50) category "not null"
        text description "nullable"
        varchar(500) logo_url "nullable"
        varchar(20) brand_color "nullable"
    }

    user {
        uuid id PK "not null"
        varchar(255) name "not null"
        varchar(255) email UK "not null"
        varchar(100) contact "nullable"
        varchar(255) affiliation "nullable"
        varchar(255) password_hash "not null"
        bool is_super_admin "nullable"
    }

    activity_type {
        uuid id PK "not null"
        uuid agency_id FK "not null"
        varchar(255) name "not null"
    }

    funding_source {
        uuid id PK "not null"
        uuid agency_id FK "not null"
        varchar(255) name "not null"
    }

    budget_category {
        uuid id PK "not null"
        uuid agency_id FK "not null"
        varchar(255) name "not null"
    }

    document_type {
        uuid id PK "not null"
        uuid agency_id FK "not null"
        varchar(255) name "not null"
        bool required_at_creation "not null"
    }

    annual_budget {
        uuid id PK "not null"
        uuid agency_id FK "not null"
        uuid funding_source_id FK "nullable"
        uuid activity_type_id FK "not null"
        int year "not null"
        decimal amount "decimal(14,2); not null"
    }

    calendar_entry {
        uuid id PK "not null"
        uuid agency_id FK "not null"
        uuid activity_type_id FK "not null"
        uuid funding_source_id FK "nullable"
        varchar(255) title "not null"
        date planned_start "not null"
        date planned_end "not null"
        varchar(255) planned_venue "nullable"
        varchar(50) status "not null"
        bool published "nullable"
    }

    activity {
        uuid id PK "not null"
        uuid agency_id FK "not null"
        uuid calendar_entry_id FK,UK "nullable"
        uuid activity_type_id FK "not null"
        uuid funding_source_id FK "nullable"
        varchar(255) title "not null"
        varchar(50) funding_type "nullable"
        varchar(255) venue "nullable"
        date start_date "not null"
        date end_date "not null"
        varchar(255) topic "nullable"
        text objective "nullable"
        text expected_outcome "nullable"
        int max_participants "nullable"
        varchar(50) status "not null"
        varchar(32) join_code UK "nullable"
    }

    %% UNIQUE activity_partner(activity_id, partner_agency_id)
    activity_partner {
        uuid id PK "not null"
        uuid agency_id FK "not null"
        uuid activity_id FK "not null"
        uuid partner_agency_id FK "not null"
        varchar(50) role "not null"
    }

    budget_item {
        uuid id PK "not null"
        uuid agency_id FK "not null"
        uuid activity_id FK "not null"
        uuid category_id FK "not null"
        uuid funding_source_id FK "nullable"
        text description "not null"
        decimal estimated_amount "decimal(14,2); not null"
    }

    actual_cost {
        uuid id PK "not null"
        uuid agency_id FK "not null"
        uuid budget_item_id FK "not null"
        uuid receipt_document_id FK "nullable"
        uuid recorded_by FK "not null"
        decimal amount "decimal(14,2); not null"
        date incurred_on "not null"
    }

    resource {
        uuid id PK "not null"
        uuid agency_id FK "not null"
        uuid activity_id FK "not null"
        uuid budget_item_id FK "nullable"
        varchar(50) resource_type "not null"
        varchar(255) name "not null"
        varchar(50) unit "not null"
        decimal qty_needed "decimal(12,2); not null"
        decimal qty_allocated "decimal(12,2); nullable"
    }

    output {
        uuid id PK "not null"
        uuid agency_id FK "not null"
        uuid activity_id FK "not null"
        text description "not null"
        varchar(50) unit "not null"
        decimal planned_qty "decimal(12,2); not null"
        decimal conducted_qty "decimal(12,2); not null"
    }

    output_photo {
        uuid id PK "not null"
        uuid agency_id FK "not null"
        uuid output_id FK "not null"
        uuid uploaded_by FK "not null"
        varchar(500) file_ref "not null"
        datetime uploaded_at "not null"
    }

    certificate_rule {
        uuid id PK "not null"
        uuid agency_id FK "not null"
        uuid activity_id FK,UK "not null"
        decimal min_attendance_pct "decimal(5,2); not null"
        bool require_feedback "not null"
        bool require_reentry_plan "not null"
    }

    %% UNIQUE session(activity_id, session_date, period)
    %% session: period: AM | PM
    session {
        uuid id PK "not null"
        uuid agency_id FK "not null"
        uuid activity_id FK "not null"
        varchar(255) title "not null"
        date session_date "not null"
        varchar(10) period "not null"
        varchar(255) venue "not null"
        varchar(128) qr_token UK "nullable"
        varchar(16) short_code "nullable"
        datetime opens_at "nullable"
        datetime closes_at "nullable"
    }

    %% program_flow: end_time > start_time
    program_flow {
        uuid id PK "not null"
        uuid agency_id FK "not null"
        uuid session_id FK "not null"
        uuid resource_person_id FK "nullable"
        varchar(255) title "not null"
        text description "nullable"
        time start_time "not null"
        time end_time "not null"
        int sort_order "not null"
    }

    attendance {
        uuid id PK "not null"
        uuid agency_id FK "not null"
        uuid session_id FK "not null"
        uuid user_id FK "not null"
        uuid client_id UK "not null"
        varchar(30) method "not null"
        datetime device_created_at "not null"
        datetime server_received_at "nullable"
        varchar(30) sync_status "not null"
    }

    feedback {
        uuid id PK "not null"
        uuid agency_id FK "not null"
        uuid session_id FK "not null"
        uuid user_id FK "not null"
        uuid client_id UK "not null"
        int rating "not null"
        text comments "not null"
        datetime submitted_at "not null"
    }

    document {
        uuid id PK "not null"
        uuid agency_id FK "not null"
        uuid activity_id FK "not null"
        uuid session_id FK "nullable"
        uuid doc_type_id FK "not null"
        uuid uploaded_by FK "not null"
        varchar(255) file_name "not null"
        varchar(500) file_ref "not null"
        datetime uploaded_at "not null"
    }

    staffing {
        uuid id PK "not null"
        uuid agency_id FK "not null"
        uuid activity_id FK "not null"
        uuid user_id FK "not null"
        varchar(255) responsibility "not null"
        varchar(50) status "not null"
    }

    agency_membership {
        uuid id PK "not null"
        uuid agency_id FK "not null"
        uuid user_id FK "not null"
        varchar(50) role "not null"
        varchar(50) status "not null"
        bool is_subscribed "not null"
    }

    invitation {
        uuid id PK "not null"
        uuid agency_id FK "not null"
        varchar(64) code UK "not null"
        varchar(50) role "not null"
        datetime expires_at "nullable"
        int max_uses "nullable"
    }

    invitation_redemption {
        uuid id PK "not null"
        uuid invitation_id FK "not null"
        uuid user_id FK "not null"
        datetime redeemed_at "not null"
    }

    registration {
        uuid id PK "not null"
        uuid agency_id FK "not null"
        uuid activity_id FK "not null"
        uuid user_id FK "not null"
        varchar(50) status "not null"
        datetime joined_at "not null"
    }

    certificate {
        uuid id PK "not null"
        uuid agency_id FK "not null"
        uuid activity_id FK "not null"
        uuid user_id FK "not null"
        uuid released_by FK "not null"
        varchar(64) certificate_no UK "not null"
        varchar(500) file_ref "nullable"
        datetime released_at "not null"
    }

    reentry_plan {
        uuid id PK "not null"
        uuid agency_id FK "not null"
        uuid activity_id FK "not null"
        uuid user_id FK "not null"
        uuid client_id UK "not null"
        text content "not null"
        datetime submitted_at "not null"
    }

    message_group {
        uuid id PK "not null"
        uuid agency_id FK "not null"
        uuid activity_id FK "not null"
        varchar(255) name "not null"
        varchar(50) scope "not null"
        bool archived "nullable"
    }

    group_member {
        uuid id PK "not null"
        uuid agency_id FK "not null"
        uuid group_id FK "not null"
        uuid user_id FK "not null"
        datetime joined_at "not null"
    }

    message {
        uuid id PK "not null"
        uuid agency_id FK "not null"
        uuid group_id FK "not null"
        uuid sender_id FK "not null"
        uuid removed_by FK "nullable"
        text body "not null"
        datetime sent_at "not null"
        bool removed "not null"
    }

